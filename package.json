{
    "name": "compoviz",
    "private": true,
    "version": "0.5.0",
    "type": "module",
    "packageManager": "yarn@4.14.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "check": "yarn lint && yarn typecheck && yarn format:check && yarn test",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"src/**/*.{ts,tsx}\" \"*.config.{js,ts}\"",
        "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"*.config.{js,cjs,mjs,ts}\" \".prettierrc\" \"index.html\" \"package.json\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"*.config.{js,cjs,mjs,ts}\" \".prettierrc\" \"index.html\" \"package.json\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "preview": "vite preview",
        "docker:dev": "docker compose up",
        "docker:restart": "docker compose restart",
        "docker:rebuild": "yarn docker:dev --build",
        "docker:down": "docker compose down",
        "docker:image-rm": "docker image rm compoviz-dev:latest",
        "docker:clean": "docker compose down --rmi local --volumes"
    },
    "dependencies": {
        "@dagrejs/dagre": "^3.1.1",
        "@hpcc-js/wasm-graphviz": "^1.18.0",
        "@vercel/analytics": "^1.6.1",
        "@xyflow/react": "^12.10.0",
        "js-yaml": "^4.1.1",
        "lucide-react": "^0.562.0",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-router-dom": "7.13.2"
    },
    "devDependencies": {
        "@eslint/js": "9.39.4",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.1",
        "@testing-library/user-event": "^14.6.1",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "24.12.0",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.1",
        "@vitest/ui": "4.0.16",
        "eslint": "9.39.4",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.0.1",
        "eslint-plugin-react-refresh": "0.5.2",
        "fast-check": "4.7.0",
        "globals": "17.4.0",
        "happy-dom": "20.1.0",
        "prettier": "3.8.1",
        "sass": "1.99.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.57.0",
        "vite": "8.0.10",
        "vitest": "4.0.16"
    }
}
